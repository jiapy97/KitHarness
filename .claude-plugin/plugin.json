{
  "name": "kitharness",
  "version": "0.5.3",
  "description": "KitHarness learns skills from real sessions, keeps durable edits, and recalls them for the current task.",
  "author": {
    "name": "KitHarness"
  },
  "homepage": "https://github.com/jiapy97/KitHarness",
  "license": "MIT",
  "mcpServers": {
    "stage_skill": {
      "command": "python3",
      "args": [
        "-m",
        "autoharness.runtime",
        "autoharness.stage_skill.server"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/src"
      }
    }
  }
}
