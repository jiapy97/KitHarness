{
  "name": "autoharness",
  "version": "0.5.3",
  "description": "KitHarness, a fork of AutoHarness: durable skill changes, task-scoped recall, and a measured three-arm study. The plugin id stays autoharness.",
  "author": {
    "name": "KitHarness fork of Tigerless Labs"
  },
  "homepage": "https://github.com/jiapy97/KitHarness",
  "license": "MIT",
  "mcpServers": {
    "stage_skill": {
      "command": "python3",
      "args": [
        "-m",
        "autoharness.runtime",
        "autoharness.stage_skill.server"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/src"
      }
    }
  }
}
